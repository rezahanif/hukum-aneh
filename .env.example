FIREBASE_PROJECT_ID=rezahanifproject
FIREBASE_CREDENTIALS_PATH=backend/configs/firebase-service-account.json

# Storage mode: firestore | postgres | dual_write
# - firestore : Firestore only (default, current production)
# - postgres  : PostgreSQL + Qdrant only (post-migration target)
# - dual_write: Write to both; reads prefer Firestore (migration cutover)
STORAGE_MODE=firestore

# PostgreSQL (required when STORAGE_MODE=postgres or dual_write)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hukum_aneh
POSTGRES_USER=hukum
POSTGRES_PASSWORD=
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIGRATIONS_PATH=backend/migrations

# Qdrant vector store (required when STORAGE_MODE=postgres; recommended for dual_write)
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=hukum_aneh_laws
QDRANT_VECTOR_SIZE=1536
QDRANT_API_KEY=

ROUTER9_BASE_URL=http://9router-service:20128/v1
ROUTER9_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_BASE_URL=http://9router-service:20128/v1
DISCOVERY_INTERVAL=1h
STUCK_JOB_THRESHOLD=6h
PYTHON_PATH=python3
SCRAPER_SCRIPT_PATH=backend/python/scraper/scrape.py
SOURCES_PATH=backend/configs/sources.json
